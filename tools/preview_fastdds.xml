<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>preview_shm</transport_id>
      <type>SHM</type>
      <!-- 1280x720 BGR 每帧约 2.6 MiB，给同机采图、推理和预览留足共享内存。 -->
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>preview_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="preview_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>preview_udp</transport_id>
        <transport_id>preview_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
