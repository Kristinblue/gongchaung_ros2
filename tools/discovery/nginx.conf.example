# 独立的 HTTPS 查询端口，部署前核对证书路径。
server {
    listen 18443 ssl;
    server_name blueee.cn;
    ssl_certificate /www/server/panel/vhost/cert/blueee.cn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/blueee.cn/privkey.pem;

    location = /gongchuang/address {
        client_max_body_size 256;
        proxy_pass http://127.0.0.1:18181;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
        proxy_cache off;
    }
}
